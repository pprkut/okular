From e1822096abc7d8960a762dd7f260a2a04a0a9a39 Mon Sep 17 00:00:00 2001
From: Heinz Wiesinger <heinz.accounts+anthropic@wiesinger.pro>
Date: Wed, 21 Oct 2026 21:06:26 +0000
Subject: [PATCH 2/3] SplashOutputDev: Cache colour conversion results in
 iccTransform

Converting a pixel through an ICC transform is expensive (lcms evaluates
the tone curves in floating point for every pixel, as the transforms are
created with cmsFLAGS_NOOPTIMIZE), while images usually contain lots of
pixels of the same colour. lcms only caches the last converted pixel.

Keep a small hash table of already converted colours for 3 component
images while transforming a scaled image, and only pass the pixels that
are not in it to GfxImageColorMap::getRGBLine(). The result is identical.

For a page with a large ICC based image this saves 20-40% of the
rendering time, e.g. 772 ms -> 602 ms at 200 dpi and 512 ms -> 312 ms
for a 1920x1080 tile at 400 dpi.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014HMJHMHEm38AikxhNxAjhE
---
 poppler/SplashOutputDev.cc | 84 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 82 insertions(+), 2 deletions(-)

diff --git a/poppler/SplashOutputDev.cc b/poppler/SplashOutputDev.cc
index c595027..cbc5ba9 100644
--- a/poppler/SplashOutputDev.cc
+++ b/poppler/SplashOutputDev.cc
@@ -2950,11 +2950,91 @@ bool SplashOutputDev::iccImageSrc(void *data, SplashColorPtr colorLine, unsigned
     return true;
 }
 
+namespace {
+
+// Converting colors through an ICC transform is expensive, while images
+// usually contain lots of pixels with the same color, so cache the results
+// of GfxImageColorMap::getRGBLine for images with 3 components per pixel.
+class RGBLineCache
+{
+public:
+    explicit RGBLineCache(GfxImageColorMap *colorMapA) : colorMap(colorMapA), keys(cacheSize, 0), values(cacheSize * 3) { }
+
+    void getRGBLine(const unsigned char *in, unsigned char *out, int length)
+    {
+        if (static_cast<int>(missPos.size()) < length) {
+            missIn.resize(3 * static_cast<size_t>(length));
+            missOut.resize(3 * static_cast<size_t>(length));
+            missPos.resize(length);
+            missKeys.resize(length);
+        }
+
+        int nMisses = 0;
+        for (int x = 0; x < length; ++x) {
+            const unsigned char *pix = in + 3 * static_cast<size_t>(x);
+            const unsigned int key = keyOf(pix);
+            const unsigned int slot = slotOf(key);
+            if (keys[slot] == key) {
+                memcpy(out + 3 * static_cast<size_t>(x), &values[3 * static_cast<size_t>(slot)], 3);
+            } else {
+                memcpy(&missIn[3 * static_cast<size_t>(nMisses)], pix, 3);
+                missPos[nMisses] = x;
+                missKeys[nMisses] = key;
+                ++nMisses;
+            }
+        }
+        if (nMisses == 0) {
+            return;
+        }
+
+        // convert the pixels that were not in the cache (note that this may
+        // modify missIn)
+        colorMap->getRGBLine(missIn.data(), missOut.data(), nMisses);
+        for (int i = 0; i < nMisses; ++i) {
+            const int x = missPos[i];
+            const unsigned int key = missKeys[i];
+            const unsigned int slot = slotOf(key);
+            keys[slot] = key;
+            memcpy(&values[3 * static_cast<size_t>(slot)], &missOut[3 * static_cast<size_t>(i)], 3);
+            memcpy(out + 3 * static_cast<size_t>(x), &missOut[3 * static_cast<size_t>(i)], 3);
+        }
+    }
+
+private:
+    static constexpr int cacheBits = 16;
+    static constexpr unsigned int cacheSize = 1 << cacheBits;
+
+    // the 24 bit color, plus a bit to tell used from unused cache slots
+    static unsigned int keyOf(const unsigned char *pix) { return 0x1000000 | (pix[0] << 16) | (pix[1] << 8) | pix[2]; }
+    static unsigned int slotOf(unsigned int key) { return (key * 2654435761U) >> (32 - cacheBits); }
+
+    GfxImageColorMap *colorMap;
+    std::vector<unsigned int> keys;
+    std::vector<unsigned char> values;
+    std::vector<unsigned char> missIn, missOut;
+    std::vector<int> missPos;
+    std::vector<unsigned int> missKeys;
+};
+
+}
