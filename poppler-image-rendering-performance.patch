 poppler/DCTStream.h  |  5 ++++-
 2 files changed, 22 insertions(+), 12 deletions(-)

diff --git a/poppler/DCTStream.cc b/poppler/DCTStream.cc
index 397771b..ae2f0d1 100644
--- a/poppler/DCTStream.cc
+++ b/poppler/DCTStream.cc
@@ -25,23 +25,28 @@ static void str_init_source(j_decompress_ptr /*cinfo*/) { }
 
 static boolean str_fill_input_buffer(j_decompress_ptr cinfo)
 {
-    int c;
     auto *src = reinterpret_cast<struct str_src_mgr *>(cinfo->src);
+    int n;
     if (src->index == 0) {
-        c = 0xFF;
-        src->index++;
-    } else if (src->index == 1) {
-        c = 0xD8;
-        src->index++;
+        // the start marker was consumed while looking for it in rewind()
+        src->buffer[0] = 0xFF;
+        src->buffer[1] = 0xD8;
+        src->index = 2;
+        n = 2;
+    } else if (src->readAhead) {
+        n = src->str->doGetChars(sizeof(src->buffer), src->buffer);
     } else {
-        c = src->str->getChar();
+        const int c = src->str->getChar();
+        src->buffer[0] = static_cast<JOCTET>(c);
+        n = c != EOF ? 1 : 0;
     }
-    src->buffer = c;
-    src->pub.next_input_byte = &src->buffer;
-    src->pub.bytes_in_buffer = 1;
-    if (c != EOF) {
+    src->pub.next_input_byte = src->buffer;
+    if (n > 0) {
+        src->pub.bytes_in_buffer = n;
         return TRUE;
     }
+    src->buffer[0] = static_cast<JOCTET>(EOF);
+    src->pub.bytes_in_buffer = 1;
