+bool Splash::getVisibleImageRect(int xDest, int yDest, int scaledWidth, int scaledHeight, int *cropX, int *cropY, int *cropWidth, int *cropHeight) const
+{
+    int clipXMin, clipYMin, clipXMax, clipYMax;
+    state->clip->getBBoxI(&clipXMin, &clipYMin, &clipXMax, &clipYMax);
+    // with anti-aliasing, pixels just outside the integer clip rectangle
+    // can still get partial coverage (see SplashClip::clipAALine), so be
+    // generous; the result is clipped exactly when blitting anyway
+    clipXMin = std::max(clipXMin - 1, 0);
+    clipYMin = std::max(clipYMin - 1, 0);
+    clipXMax = std::min(clipXMax + 1, bitmap->getWidth() - 1);
+    clipYMax = std::min(clipYMax + 1, bitmap->getHeight() - 1);
+
+    // work in 64 bit to avoid overflows with huge images
+    const long long x0 = std::max(static_cast<long long>(xDest), static_cast<long long>(clipXMin));
+    const long long y0 = std::max(static_cast<long long>(yDest), static_cast<long long>(clipYMin));
+    const long long x1 = std::min(static_cast<long long>(xDest) + scaledWidth - 1, static_cast<long long>(clipXMax));
+    const long long y1 = std::min(static_cast<long long>(yDest) + scaledHeight - 1, static_cast<long long>(clipYMax));
+    if (x0 > x1 || y0 > y1) {
+        return false;
+    }
+    *cropX = static_cast<int>(x0 - xDest);
+    *cropY = static_cast<int>(y0 - yDest);
+    *cropWidth = static_cast<int>(x1 - x0 + 1);
+    *cropHeight = static_cast<int>(y1 - y0 + 1);
+    return true;
+}
